from pathlib import Path

THIS_DIR = Path(__file__).resolve().parent

PLAYBOOK_TEXT = r"""PLACEHOLDER â€” replace with the verbatim playbook text."""

HANDOFF_TEXT = r"""PLACEHOLDER â€” replace with the verbatim handoff text."""


def print_playbook(which: str = "main") -> None:
